# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/

# Virtual environment
.venv/
venv/
env/

# IDE specific
.vscode/
.idea/
*.swp
*.swo

# Logs and temporary files
logs/
*.log
temp/
*.tmp

# Downloads and generated content (exclude from image)
downloads/
static/covers/
static/img/readme/

# FFmpeg binaries (Docker will install its own)
ffmpeg/

# Database files (exclude from image)  
db/
tasks.db
*.db
*.sqlite
*.sqlite3

# Configuration and secrets (handle via volumes)
config/
cookies/
*.key
*.pem

# OS specific
.DS_Store
Thumbs.db
desktop.ini

# Docker specific files
.dockerignore
docker-compose.yml
docker-compose-build.yml
Makefile

# Git files
.git/
.gitignore
.gitattributes

# Documentation and development files
README.md
LICENSE
*.md
docs/

# Backup files
*.bak
*.backup
*~

# Test files
test_*.py
*_test.py
tests/

# Development scripts (start.* etc.), but the prefetch.sh + cache subdirs are
# explicitly allowed through so the Dockerfile can COPY them as a build-time
# fast-path. Run ./build-tools/prefetch.sh on the host to populate them.
start.bat
start.ps1
build-tools/
!build-tools/ffmpeg-cache/
!build-tools/ffmpeg-cache/**
!build-tools/pip-cache/
!build-tools/pip-cache/**
!build-tools/prefetch.sh